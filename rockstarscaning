local ReportData = {}
local LastReportJSON = ""

local function UpdateJSONAndCopy(statusMessage)
    local ok, encoded = pcall(function()
        return HttpService:JSONEncode(ReportData)
    end)
    if ok then
        LastReportJSON = encoded
        local copied = CopyToClipboard(LastReportJSON)
