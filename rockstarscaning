local function RunFullMapScan()
    SetProgress(0.1, "[1/5] Memindai Info Game & Data Pemain...")
    task.wait(0.05)

    local gameName = "Unknown"
    pcall(function()
        gameName = MarketplaceService:GetProductInfo(game.PlaceId).Name
    end)

    local char = LocalPlayer.Character
    local myPos = char and GetObjectPosition(char) or "N/A"

    local playerFolders = {}
    for _, ch in ipairs(LocalPlayer:GetChildren()) do
        if not ch:IsA("PlayerGui") and not ch:IsA("Backpack") and not ch:IsA("PlayerScripts") and not ch:IsA("StarterGear") then
            playerFolders[ch.Name .. "(" .. ch.ClassName .. ")"] = {
                Attrs = GetSafeAttributes(ch),
                Values = GetValueChildren(ch),
                Children = ScanNodeRecursive(ch, 2, 1)
            }
        end
    end

    ReportData.GameInfo = {
        GameName = gameName,
        PlaceId = game.PlaceId,
        GameId = game.GameId,
        PlaceVersion = game.PlaceVersion,
        PlayerPosition = myPos,
        PlayerAttributes = GetSafeAttributes(LocalPlayer),
        PlayerDataFolders = playerFolders,
    }

    SetProgress(0.35, "[2/5] Memindai Hirarki Workspace (4 Level)...")
    task.wait(0.05)
    ReportData.WorkspaceTree = ScanNodeRecursive(Workspace, 4, 1)

    SetProgress(0.55, "[3/5] Mendeteksi Plot / Base & ProximityPrompt...")
    task.wait(0.05)
    local detectedBases, promptGroups, clickGroups = {}, {}, {}

    for _, desc in ipairs(Workspace:GetDescendants()) do
        if (desc:IsA("Model") or desc:IsA("Folder")) and #detectedBases < 20 then
            local attrs = GetSafeAttributes(desc)
            local vals = GetValueChildren(desc)
            local nLower = desc.Name:lower()
            local isBase = nLower:find("base") or nLower:find("plot") or nLower:find("tycoon") or nLower:find("stand")
            local hasOwner = false
            if attrs then
                for k, _ in pairs(attrs) do
                    local kl = k:lower()
                    if kl:find("owner") or kl:find("user") or kl:find("player") or kl:find("claim") then hasOwner = true end
                end
            end
            if vals then
                for k, _ in pairs(vals) do
                    local kl = k:lower()
                    if kl:find("owner") or kl:find("user") or kl:find("player") then hasOwner = true end
                end
            end
            if hasOwner or (isBase and desc.Parent and (desc.Parent == Workspace or desc.Parent.Name:lower():find("plot") or desc.Parent.Name:lower():find("base"))) then
                table.insert(detectedBases, {
                    Path = desc:GetFullName(),
                    Pos = GetObjectPosition(desc),
                    Attrs = attrs,
                    Values = vals,
                    Children = ScanNodeRecursive(desc, 2, 1)
                })
            end
        elseif desc:IsA("ProximityPrompt") then
            local pName = desc.Parent and desc.Parent.Name or "?"
            local sig = desc.Name .. "|" .. tostring(desc.ActionText) .. "|" .. tostring(desc.ObjectText) .. "|" .. pName
            if not promptGroups[sig] then
                promptGroups[sig] = {
                    PromptName = desc.Name,
                    ActionText = desc.ActionText,
                    ObjectText = desc.ObjectText,
                    HoldDuration = Round(desc.HoldDuration),
                    MaxDist = Round(desc.MaxActivationDistance),
                    SamplePath = desc:GetFullName(),
                    SamplePos = GetObjectPosition(desc),
                    ParentAttrs = desc.Parent and GetSafeAttributes(desc.Parent) or nil,
                    Count = 0
                }
            end
            promptGroups[sig].Count = promptGroups[sig].Count + 1
        elseif desc:IsA("ClickDetector") then
            local pName = desc.Parent and desc.Parent.Name or "?"
            if not clickGroups[pName] then
                clickGroups[pName] = {
                    ParentName = pName,
                    SamplePath = desc:GetFullName(),
                    SamplePos = GetObjectPosition(desc),
                    Count = 0
                }
            end
            clickGroups[pName].Count = clickGroups[pName].Count + 1
        end
    end

    local promptList, clickList = {}, {}
    for _, v in pairs(promptGroups) do
        table.insert(promptList, v)
        if #promptList >= 40 then break end
    end
    for _, v in pairs(clickGroups) do
        table.insert(clickList, v)
        if #clickList >= 25 then break end
    end
    ReportData.DetectedPlotsOrBases = detectedBases
    ReportData.InteractivePrompts = promptList
    ReportData.ClickDetectors = clickList

    SetProgress(0.80, "[4/5] Memindai Semua Remote & ModuleScript...")
    task.wait(0.05)
    local remotes, modules = {}, {}
    for _, d in ipairs(ReplicatedStorage:GetDescendants()) do
        if d:IsA("RemoteEvent") or d:IsA("RemoteFunction") or d:IsA("UnreliableRemoteEvent") then
            table.insert(remotes, { Class = d.ClassName, Name = d.Name, Path = d:GetFullName() })
        elseif d:IsA("ModuleScript") and #modules < 65 then
            table.insert(modules, d:GetFullName())
        end
    end
    for _, d in ipairs(Workspace:GetDescendants()) do
        if d:IsA("RemoteEvent") or d:IsA("RemoteFunction") then
            table.insert(remotes, { Class = d.ClassName, Name = d.Name, Path = d:GetFullName() })
        end
    end
    ReportData.Remotes = remotes
    ReportData.ReplicatedModules = modules

    UpdateJSONAndCopy("✅ Full Map Scan Selesai!")
    logBox.Text = string.format(
        "=== [FULL MAP SCAN v4.0] ===\n" ..
        "Game        : %s (%d)\n" ..
        "Posisi Kamu : %s\n" ..
        "Workspace   : %d Grup Utama\n" ..
        "Plot/Base   : %d Terdeteksi\n" ..
        "Prompts     : %d Jenis ProximityPrompt\n" ..
        "Remotes     : %d RemoteEvent/Function\n" ..
        "Modules     : %d ModuleScript\n" ..
        "Ukuran JSON : %d Karakter\n\n" ..
        "💡 Tips: Berdirilah di dekat objek penting lalu klik [📍 SCAN DEKAT] untuk detail 100%%!",
        tostring(gameName), game.PlaceId, tostring(myPos),
        #(ReportData.WorkspaceTree or {}), #detectedBases, #promptList, #remotes, #modules, #LastReportJSON
    )
end

-- FITUR 2: SCAN RADIUS DEKAT (100 STUD DARI KARAKTER)
local function RunNearbyRadiusScan()
    local char = LocalPlayer.Character
    local myPos = char and GetRawPosition(char)
    if not myPos then
        statusLbl.Text = "⚠️ Karakter belum muncul!"
        return
    end

    SetProgress(0.4, "Memindai semua objek dalam radius 100 stud dari karaktermu...")
    task.wait(0.05)

    local nearbyItems = {}
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") or obj:IsA("ProximityPrompt") or obj:IsA("ClickDetector") or (obj:IsA("BasePart") and (GetSafeAttributes(obj) ~= nil or GetValueChildren(obj) ~= nil)) then
            if not Players:GetPlayerFromCharacter(obj) and not (char and obj:IsDescendantOf(char)) then
                local pos = GetRawPosition(obj)
                if pos then
                    local dist = (pos - myPos).Magnitude
                    if dist <= 100 then
                        table.insert(nearbyItems, {
                            Dist = Round(dist),
                            Name = obj.Name,
                            Class = obj.ClassName,
                            Path = obj:GetFullName(),
                            Pos = FormatVector3(pos),
                            Attrs = GetSafeAttributes(obj),
                            Values = GetValueChildren(obj),
                            PromptAction = obj:IsA("ProximityPrompt") and (obj.ActionText .. " | " .. obj.ObjectText) or nil
                        })
                    end
                end
            end
        end
    end

    table.sort(nearbyItems, function(a, b) return (a.Dist or 999) < (b.Dist or 999) end)
    local trimmed = {}
    for i = 1, math.min(#nearbyItems, 60) do
        trimmed[i] = nearbyItems[i]
    end

    ReportData.NearbyRadiusScan = {
        CenterPosition = FormatVector3(myPos),
        TotalFound = #nearbyItems,
        ClosestObjects = trimmed
    }

    UpdateJSONAndCopy("✅ Scan Radius 100m Selesai! (" .. tostring(#nearbyItems) .. " objek)")
    logBox.Text = logBox.Text .. "\n\n[📍 SCAN DEKAT]: Ditemukan " .. tostring(#nearbyItems) .. " objek penting di sekitar karaktermu! JSON telah diperbarui & disalin."
end

