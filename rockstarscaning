-- 1. FUNGSI SERIALIZER & FORMATTER PRESISI
-- ============================================================================
local function Round(n)
    if type(n) ~= "number" then return n end
    return math.floor(n * 10 + 0.5) / 10
end

local function FormatVector3(v)
    if typeof(v) ~= "Vector3" then return nil end
    return string.format("%.1f, %.1f, %.1f", v.X, v.Y, v.Z)
end

local function GetRawPosition(obj)
    local ok, pos = pcall(function()
        if obj:IsA("BasePart") then
            return obj.Position
        elseif obj:IsA("Model") then
            return obj:GetPivot().Position
        elseif obj.Parent and obj.Parent:IsA("BasePart") then
            return obj.Parent.Position
        elseif obj.Parent and obj.Parent:IsA("Model") then
            return obj.Parent:GetPivot().Position
        end
        return nil
    end)
    return ok and pos or nil
end

local function GetObjectPosition(obj)
    local pos = GetRawPosition(obj)
    return pos and FormatVector3(pos) or nil
end

local function SerializeValue(val, depth)
    depth = depth or 0
    local t = typeof(val)
    if t == "number" then
        return Round(val)
    elseif t == "string" then
        return #val > 90 and (val:sub(1, 90) .. "...") or val
    elseif t == "boolean" then
        return val
    elseif t == "Vector3" then
        return FormatVector3(val)
    elseif t == "CFrame" then
        return FormatVector3(val.Position)
    elseif t == "Color3" then
        return string.format("RGB(%d,%d,%d)", math.floor(val.R * 255), math.floor(val.G * 255), math.floor(val.B * 255))
    elseif t == "Instance" then
        return val:GetFullName()
    elseif t == "table" and depth < 2 then
        local out = {}
        local count = 0
        for k, v in pairs(val) do
            count = count + 1
            if count > 15 then
                out["__more"] = "..."
                break
            end
            out[tostring(k)] = SerializeValue(v, depth + 1)
        end
        return out
    end
    return tostring(val)
end

local function GetSafeAttributes(obj)
    local ok, attrs = pcall(function() return obj:GetAttributes() end)
    if not ok or type(attrs) ~= "table" then return nil end
    local res, hasAny = {}, false
    for k, v in pairs(attrs) do
        hasAny = true
        res[k] = SerializeValue(v)
    end
    return hasAny and res or nil
end

local function GetValueChildren(obj)
    local vals, hasAny = {}, false
    pcall(function()
        for _, ch in ipairs(obj:GetChildren()) do
            if ch:IsA("ValueBase") then
                hasAny = true
                vals[ch.Name .. "(" .. ch.ClassName .. ")"] = SerializeValue(ch.Value)
            end
        end
    end)
    return hasAny and vals or nil
end

local function CopyToClipboard(str)
    local fn = setclipboard or toclipboard or (type(syn) == "table" and syn.write_clipboard)
    if type(fn) == "function" then
        local ok = pcall(fn, str)
        return ok
    end
    return false
end

