            local nLower = mod.Name:lower()
            if nLower:find("egg") or nLower:find("pet") or nLower:find("animal") or nLower:find("zone")
                or nLower:find("shop") or nLower:find("item") or nLower:find("config") or nLower:find("data")
                or nLower:find("upgrade") or nLower:find("rarity") or nLower:find("fuse") or nLower:find("event") then
                count = count + 1
                local finished = false
                task.spawn(function()
                    local ok, res = pcall(require, mod)
                    if ok and type(res) == "table" then
                        dumped[mod:GetFullName()] = SerializeValue(res, 0)
                    end
                    finished = true
                end)
                local t0 = os.clock()
                while not finished and (os.clock() - t0) < 0.25 do
                    task.wait()
                end
            end
        end
    end

    ReportData.ModuleConfigDump = dumped
    UpdateJSONAndCopy("✅ Bongkar Module Selesai! (" .. tostring(count) .. " module)")
    logBox.Text = logBox.Text .. "\n\n[📦 BONGKAR MODULE]: Berhasil mengekstrak " .. tostring(count) .. " ModuleScript Config! JSON telah diperbarui & disalin."
end

-- FITUR 4: REKAM REMOTE LIVE (10 DETIK)
local isSniffing = false
local sniffHookInstalled = false
local capturedCalls = {}

local function RunLiveRemoteSniffer()
    if isSniffing then return end
    if type(getrawmetatable) ~= "function" then
        statusLbl.Text = "⚠️ Executor tidak mendukung getrawmetatable."
        return
    end

    capturedCalls = {}
    isSniffing = true

    if not sniffHookInstalled then
        sniffHookInstalled = true
        pcall(function()
            local mt = getrawmetatable(game)
            local oldNamecall = mt.__namecall
            if setreadonly then setreadonly(mt, false) end

            local inHook = false
            mt.__namecall = newcclosure and newcclosure(function(self, ...)
                if isSniffing and not inHook then
                    local method = getnamecallmethod and getnamecallmethod()
                    if method == "FireServer" or method == "InvokeServer" then
                        inHook = true
                        local args = { ... }
                        pcall(function()
                            local rName = tostring(self)
                            if not rName:find("CharacterSound") and not rName:find("Integrity") then
                                local sArgs = {}
                                for i = 1, math.min(#args, 6) do
                                    sArgs[i] = SerializeValue(args[i], 0)
                                end
                                table.insert(capturedCalls, {
                                    Method = method,
                                    Remote = self:GetFullName(),
                                    Args = sArgs
                                })
                            end
                        end)
                        inHook = false
                    end
                end
                return oldNamecall(self, ...)
            end) or mt.__namecall

            if setreadonly then setreadonly(mt, true) end
        end)
    end

    for sec = 10, 1, -1 do
        btnSniff.Text = "🔴 MEREKAM (" .. tostring(sec) .. "d)"
        statusLbl.Text = "Lakukan aksi di game sekarang! Tertangkap: " .. tostring(#capturedCalls) .. " Remote"
        task.wait(1)
    end

    isSniffing = false
    btnSniff.Text = "🎥 REKAM REMOTE (10d)"
    ReportData.CapturedRemoteCalls = capturedCalls

    UpdateJSONAndCopy("✅ Rekaman Selesai! (" .. tostring(#capturedCalls) .. " Remote)")
    logBox.Text = logBox.Text .. "\n\n[🎥 LIVE SNIFFER]: Berhasil menangkap " .. tostring(#capturedCalls) .. " panggilan Remote beserta argumennya! JSON telah disalin."
end

