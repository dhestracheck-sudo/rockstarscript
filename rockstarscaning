            pcall(writefile, "RockstarScan_" .. tostring(game.PlaceId) .. ".json", LastReportJSON)
        end
        SetProgress(1, statusMessage .. (copied and " (Otomatis Disalin!)" or ""))
    else
        SetProgress(1, "❌ Gagal mengemas JSON.")
    end
end

local function ScanNodeRecursive(root, maxDepth, currentDepth)
    currentDepth = currentDepth or 1
    if currentDepth > maxDepth then return nil end

    local children = root:GetChildren()
    if #children == 0 then return nil end

    local groups, groupOrder = {}, {}
    for _, child in ipairs(children) do
        if not (currentDepth == 1 and Players:GetPlayerFromCharacter(child)) then
            local key = child.ClassName .. ":" .. child.Name
            if not groups[key] then
                groups[key] = {
                    Name = child.Name,
                    Class = child.ClassName,
                    Count = 0,
                    FirstInstance = child,
                    SamplePositions = {},
                }
                table.insert(groupOrder, key)
            end
            local g = groups[key]
            g.Count = g.Count + 1
            if #g.SamplePositions < 3 then
                local pos = GetObjectPosition(child)
                if pos then table.insert(g.SamplePositions, pos) end
            end
        end
    end

    local result = {}
    for idx, key in ipairs(groupOrder) do
        if idx > 45 then
            table.insert(result, { Note = "... +" .. tostring(#groupOrder - 45) .. " grup lainnya" })
            break
        end
        local g = groups[key]
        local inst = g.FirstInstance
        local entry = {
            Name = g.Name,
            Class = g.Class,
            Count = g.Count > 1 and g.Count or nil,
            Pos = #g.SamplePositions > 0 and g.SamplePositions or nil,
            Attrs = GetSafeAttributes(inst),
            Values = GetValueChildren(inst),
        }
        if currentDepth < maxDepth then
            local sub = ScanNodeRecursive(inst, maxDepth, currentDepth + 1)
            if sub and #sub > 0 then
                entry.Children = sub
            end
        end
        table.insert(result, entry)
    end
    return result
end

